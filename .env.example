# Variables de entorno para OftalmoCare
# Completa estos valores con tus credenciales de Supabase y Google AI Studio

# Supabase (https://supabase.com -> Settings -> API)
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-supabase-anon-key-aqui

# Google AI Studio (Gemini API) (https://aistudio.google.com -> Get API Key)
VITE_GEMINI_API_KEY=tu-google-ai-studio-gemini-api-key

# WhatsApp del Consultorio (Código de país + número, sin signos ni espacios, ej: 5491112345678)
VITE_CLINIC_WHATSAPP=5491145892011
VITE_CLINIC_NAME="OftalmoCare Consultorios Oftalmológicos"
